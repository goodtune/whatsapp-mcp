# Copy to .env and fill in before running `docker compose up`.

# A long random string used to sign OAuth access tokens. Required.
JWT_SECRET=

# The GitHub OAuth app users sign in with. Required. Create one at
# https://github.com/settings/applications/new with the callback URL
# <PUBLIC_URL>/oauth/github/callback (the server prints the exact URL it
# expects at startup).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The GitHub logins allowed to sign in, comma-separated. Required.
GITHUB_ALLOWED_USERS=

# The URL MCP clients and browsers reach the server at. Ignored when
# NGROK_AUTHTOKEN is set (the tunnel's URL is used instead).
PUBLIC_URL=http://localhost:8080

# Optional: set this to expose the server on a public ngrok tunnel instead of
# (only) the local port mapping below — handy for self-hosting without
# port-forwarding or a reverse proxy. Get a token at
# https://dashboard.ngrok.com/get-started/your-authtoken. Leave unset to just
# use the local port mapping.
#
# If you keep this in dotvault (https://github.com/goodtune/dotvault) instead,
# leave this unset and pass `--ngrok-dotvault <field>` on the command line when
# running the binary directly — that's a CLI flag, not an env var, so it isn't
# set here; see the README.
NGROK_AUTHTOKEN=

# Only used when NGROK_AUTHTOKEN is set: pins the tunnel to a reserved
# domain so its URL is stable across restarts (otherwise ngrok assigns a new
# random one each time, which breaks the GitHub OAuth app's callback URL).
NGROK_DOMAIN=
