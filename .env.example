# Copy to .env and fill in before running `docker compose up`.

# A long random string used to sign session JWTs. Required.
JWT_SECRET=

# Optional: set this to expose the server on a public ngrok tunnel instead of
# (only) the local port mapping below — handy for self-hosting without
# port-forwarding or a reverse proxy. Get a token at
# https://dashboard.ngrok.com/get-started/your-authtoken. Leave unset to just
# use the local port mapping.
NGROK_AUTHTOKEN=

# Optional, only used when NGROK_AUTHTOKEN is set:
# - NGROK_DOMAIN pins the tunnel to a reserved domain so its URL is stable
#   across restarts (otherwise ngrok assigns a new random one each time).
# - NGROK_BASIC_AUTH_USER/PASS require HTTP basic auth at the ngrok edge for
#   every request, including /api/register — strongly recommended, since
#   that endpoint is otherwise open to anyone who can reach the server.
NGROK_DOMAIN=
NGROK_BASIC_AUTH_USER=
NGROK_BASIC_AUTH_PASS=
